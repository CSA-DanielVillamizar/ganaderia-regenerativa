{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "dependsOn": []
    },
    "build": {
      "outputs": ["dist/**", ".next/**", "build/**"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:unit": {
      "cache": false
    },
    "test:api": {
      "cache": false
    },
    "test:all": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "dependsOn": []
    },
    "test:cov": {
      "cache": false
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "format": {
      "outputs": [],
      "cache": true
    },
    "format:fix": {
      "outputs": [],
      "cache": true
    },
    "db:push": {
      "cache": false,
      "persistent": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": false
    },
    "db:seed": {
      "cache": false,
      "persistent": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
