# API - Variables de entorno
# Ganadería Regenerativa - Backend

# ============================================================================
# 🗄️ BASE DE DATOS - SQL SERVER (Windows Local)
# ============================================================================
# Formato: sqlserver://[server]:[port];database=[db];user=[user];password=[pass];encrypt=true;trustServerCertificate=true
#
# Para SQL Server Express local (port 1433):
#   sqlserver://localhost:1433;database=ganaderia_db;user=sa;password=TuPassword123;encrypt=true;trustServerCertificate=true
#
# Variables reemplazables:
#   localhost:1433  → Servidor y puerto (ajusta si está en otra máquina)
#   ganaderia_db    → Nombre de la BD (debe existir en SSMS)
#   sa              → Usuario (o tu usuario personalizado)
#   TuPassword123   → Contraseña del usuario SQL Server
#   encrypt=true    → Conexión encriptada (recomendado)
#   trustServerCertificate=true → Confiar en certificado auto-firmado (solo desarrollo)
#
DATABASE_URL="sqlserver://localhost:1433;database=ganaderia_db;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true"

# ============================================================================
# 🔐 AUTENTICACIÓN JWT
# ============================================================================
# Usa una clave larga y aleatoria (mínimo 64 caracteres en producción)
JWT_SECRET="tu-clave-secreta-super-larga-minimo-64-caracteres-aleatoria-aqui"
JWT_EXPIRATION="24h"

# ============================================================================
# 🌍 SERVIDOR & CONFIGURACIÓN
# ============================================================================
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3001"
LOG_LEVEL="debug"

# ============================================================================
# ⚠️  NOTAS IMPORTANTES
# ============================================================================
#
# 1. SQL Server debe estar CORRIENDO antes de iniciar la API
#    → Servicios de Windows: MSSQLSERVER debe estar "En ejecución"
#
# 2. La BD debe existir previamente en SQL Server (SSMS):
#    CREATE DATABASE ganaderia_db COLLATE SQL_Latin1_General_CP1_CI_AS;
#
# 3. El usuario SA debe estar habilitado:
#    ALTER LOGIN sa ENABLE;
#    ALTER LOGIN sa WITH PASSWORD = 'YourPassword123';
#
# 4. Para desarrollo sin SSL, usa:
#    encrypt=false;trustServerCertificate=true
#
# 5. Para producción, obtén certificado válido:
#    encrypt=true;trustServerCertificate=false
#
# ============================================================================
