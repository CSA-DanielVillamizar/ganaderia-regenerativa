    "@types/node": "20.10.6",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "10.4.17",
    "eslint": "8.56.0",
    "eslint-config-next": "14.2.0",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "^27.4.0",
    "postcss": "8.4.32",
    "prettier": "3.1.1",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3",
    "vitest": "1.1.0"
